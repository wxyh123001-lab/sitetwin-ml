# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.ipynb_checkpoints/

# Local secrets / environment (TB_USERNAME / TB_PASSWORD live here, never committed)
.env
*.env

# Trained models: trained per-site at runtime via cold start, not source.
# Ignored on master (each site trains its own). THIS branch (`models`) is the
# one exception -- models/ is deliberately tracked here so it can be checked
# out to skip cold start when testing the real-data L2/L3 path. Do not merge
# this line back into master.
# models/

# Generated data and cold-start collection buffers. THIS branch (`models`)
# tracks the pure-simulator files (normal_snapshots.*) so they ship with the
# model for quick testing -- but real_snapshots.pkl / combined_snapshots.pkl
# / collection_buffer.pkl all contain actual site telemetry (derived from
# deploy/pod*_full.json or a live cold-start run) and stay local-only, same
# reasoning as the raw dumps below (repo is public).
training_data/real_snapshots.pkl
training_data/combined_snapshots.pkl
training_data/collection_buffer.pkl

# Raw ThingsBoard dumps pulled by deploy/fetch_all_data.sh -- real site data,
# repo is public, kept local-only. Regenerate via that script + convert with
# deploy/convert_real_data.py rather than committing the dumps themselves.
deploy/pod*_full.json

# Model-selection experiment outputs (regenerable via ml/train_*.py)
ml/experiments/

# IDE
.idea/
.vscode/

# OS / editor
.DS_Store
Thumbs.db
